      "tag": "L2",
      "title": "Open at the top",
      "text": "Legs open to the width of the frame, roll down, then close at the bottom."
    },
    {
      "tag": "L3",
      "title": "Reverse it",
      "text": "Open at the bottom, close at the top."
    }
